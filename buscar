#idea de mejora-> un segundo argumento indica donde hacer la busqueda
#   ej buscar ./ archivo

if (( $# == 1 ));
then
    echo -e "\n\tBuscant en /, tardarà uns instants...\n"
    echo -e "\tvvvv"

    find / -iname $1 2> /dev/null

    echo -e "\t^^^^\n"
    echo -e "\tRecerca finalitzada, mostrant resultats.\n"
else
    echo -e "\n\tBuscar amb: buscar nomArchiuBuscat\n"
fi

