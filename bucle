# Un script que me ahorre escribir un bucle infinito en terminal.

#HISTORIAL
# 27.10.26 - Hecho bucle con traza y salida con CtrlC

#Mejoras
#-Añadir pausa con las opciones
#-Añadir repeticiones maximas.
#- id de iteracion



trap ctrl_c INT TERM #ERR
ctrl_c() { #Captura el Ctrl+c i reseteja
    #Desactiva la traza para la salida
    set +x
    echo
    echo -e "\tEixint."
    echo
    exit
}

while true; do
    #Activamos la traza localmente
    ( eval "set -x; $@" )
    echo
    sleep 0.1
done
